# Godot 4
.godot/

# Sibling addons, linked for the suite (see README):
#   ln -s ../../dot-core/addons/dot_core addons/dot_core
#   ln -s ../../dot-bot/addons/dot_bot addons/dot_bot
/addons/dot_core
/addons/dot_bot
# dot-bot's own dependencies:
/addons/dot_sql
/addons/godot-sqlite
/addons/dot_bot_record
# The snapshot suite's (examples/snapshot_selftest): dot-net and its profiler.
/addons/dot_net
/addons/dot_profile
# The arms parity test's script (examples/sim_selftest): dot-player-char's clearance scan.
#   ln -s ../../../dot-player-char/addons/dot_player_char/nodes/dot_view_arms_clear.gd examples/linked/
/examples/linked/

# The built library and its .gdextension, written by ci/install.sh; never committed.
/addons/dot_sim/bin/
/addons/dot_sim/dot_sim.gdextension
/addons/dot_sim/dot_sim.gdextension.uid

# Rust
rust/target/

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Release packaging output (ci/package.sh).
dist/
